// Widget de Rádio Vice City
const estacoes = [
    "Estação: Wave 103 (Synthwave)",
    "Estação: Flash FM (Hits Pop 80s)",
    "Estação: V-Rock (Hard Rock)",
    "Estação: Fever 105 (Funk & Soul)"
];
let estacaoAtual = 0;
let tocando = false;

const elEstacao = document.getElementById("radio-musica");
const btnPlay = document.getElementById("btn-radio-play");
const btnNext = document.getElementById("btn-radio-next");
const btnPrev = document.getElementById("btn-radio-prev");

if (btnNext) {
    btnNext.onclick = () => {
        estacaoAtual = (estacaoAtual + 1) % estacoes.length;
        if (elEstacao) elEstacao.innerText = estacoes[estacaoAtual];
    };
}

if (btnPrev) {
    btnPrev.onclick = () => {
        estacaoAtual = (estacaoAtual - 1 + estacoes.length) % estacoes.length;
        if (elEstacao) elEstacao.innerText = estacoes[estacaoAtual];
    };
}

if (btnPlay) {
    btnPlay.onclick = () => {
        tocando = !tocando;
        btnPlay.innerText = tocando ? "⏸" : "▶";
        btnPlay.classList.toggle("ativo", tocando);
    };
}

// Formulário VIP
const formVip = document.getElementById("form-vip");
if (formVip) {
    formVip.onsubmit = function(e) {
