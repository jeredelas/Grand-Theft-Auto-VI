// =========================================================
// SINTETIZADOR DE ÁUDIO WEB (SIRENES, BEEP & AMBIÊNCIA)
// =========================================================

let audioCtx = null;
let oscSiren = null;
let oscLfo = null;
let gainSiren = null;
let oscAmbient = null;
let gainAmbient = null;
let somAtivo = false;

// Função para garantir que o AudioContext seja criado e ativado corretamente
function obterAudioContext() {
    if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
            audioCtx = new AudioContextClass();
        }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
    }
    return audioCtx;
}

// Destrava o sistema de som do navegador no primeiro clique do usuário na página
function destravarAudio() {
    obterAudioContext();
    document.removeEventListener('click', destravarAudio);
    document.removeEventListener('touchstart', destravarAudio);
}
document.addEventListener('click', destravarAudio);
document.addEventListener('touchstart', destravarAudio);

// 1. Liga / Desliga o Som da Sirene e Ambiência Synthwave
function alternarSomAmbiente() {
    const ctx = obterAudioContext();

    if (!ctx) {
        alert("Seu navegador não suporta Web Audio API.");
        return;
    }

    if (!somAtivo) {
        try {
            // --- A) SIRENE POLICIAL (Oscilador com Variação LFO) ---
            oscSiren = ctx.createOscillator();
            oscLfo = ctx.createOscillator();
            gainSiren = ctx.createGain();
            let lfoGain = ctx.createGain();

            oscSiren.type = 'sawtooth';
            oscSiren.frequency.value = 700; // Frequência audível da sirene

            oscLfo.type = 'sine';
            oscLfo.frequency.value = 0.4; // Velocidade da oscilação da sirene
            lfoGain.gain.value = 300; // Oscila entre 400Hz e 1000Hz

            oscLfo.connect(lfoGain);
            lfoGain.connect(oscSiren.frequency);

            gainSiren.gain.value = 0.15; // Volume AUMENTADO (antes era 0.04)

            oscSiren.connect(gainSiren);
            gainSiren.connect(ctx.destination);

            oscSiren.start();
            oscLfo.start();

            // --- B) GRAVE SYNTHWAVE DE FUNDO ---
            oscAmbient = ctx.createOscillator();
            gainAmbient = ctx.createGain();

            oscAmbient.type = 'sawtooth';
            oscAmbient.frequency.value = 65; // Nota grave perceptível
            gainAmbient.gain.value = 0.10;

            // Filtro Lowpass para deixar o grave aveludado e retrô
            let filtro = ctx.createBiquadFilter();
            filtro.type = 'lowpass';
            filtro.frequency.value = 250;

            oscAmbient.connect(filtro);
            filtro.connect(gainAmbient);
            gainAmbient.connect(ctx.destination);

            oscAmbient.start();

            somAtivo = true;

            // Atualiza visual do botão
            const btn = document.getElementById("btn-som-ambiente");
            const icone = document.getElementById("icone-som");
            if (btn) btn.style.borderColor = "var(--rosa-neon)";
            if (icone) icone.innerText = "🔇";

            console.log("🔊 Sirene e Som Neon LIGADOS!");
        } catch (erro) {
            console.error("Erro ao tocar áudio:", erro);
        }
    } else {
        desativarSomAmbiente();
    }
}

function desativarSomAmbiente() {
    if (oscSiren) { try { oscSiren.stop(); oscSiren.disconnect(); } catch(e){} }
    if (oscLfo) { try { oscLfo.stop(); oscLfo.disconnect(); } catch(e){} }
    if (oscAmbient) { try { oscAmbient.stop(); oscAmbient.disconnect(); } catch(e){} }

    somAtivo = false;

    const btn = document.getElementById("btn-som-ambiente");
    const icone = document.getElementById("icone-som");
    if (btn) btn.style.borderColor = "var(--azul-neon)";
    if (icone) icone.innerText = "🔊";

    console.log("🔇 Som DESLIGADO.");
}

// Vincula ao botão da barra superior
const btnSom = document.getElementById("btn-som-ambiente");
if (btnSom) {
    btnSom.addEventListener("click", alternarSomAmbiente);
}

// 2. Efeito Sonoro (Beep Futurista) ao passar o mouse nos botões
function tocarBeepHover() {
    const ctx = obterAudioContext();
    if (!ctx) return;

    try {
        let osc = ctx.createOscillator();
        let gain = ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, ctx.currentTime + 0.08);

        gain.gain.setValueAtTime(0.08, ctx.currentTime); // Volume audível
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start();
        osc.stop(ctx.currentTime + 0.08);
    } catch (e) {}
}

document.querySelectorAll('.btn-surreal, .menu-navegacao a, .botao-nav-glow').forEach(elemento => {
    elemento.addEventListener('mouseenter', tocarBeepHover);
});

