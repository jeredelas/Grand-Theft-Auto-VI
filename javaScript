// =========================================================
// SISTEMA DE ÁUDIO POLICIAL DO GTA (WAIL, YELP, HORN & RADIO)
// =========================================================

let audioCtx = null;
let sirenOsc1 = null;
let sirenOsc2 = null;
let sirenFilter = null;
let sirenGain = null;
let sirenInterval = null;
let oscAmbient = null;
let gainAmbient = null;

let somAtivo = false;
let modoSirene = 'WAIL'; // 'WAIL' (Lenta) ou 'YELP' (Rápida)

// Garante e inicializa o sistema de som
function obterAudioContext() {
    if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
            audioCtx = new AudioContextClass();
        }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
    }
    return audioCtx;
}

// Destrava o áudio no primeiro clique/toque na tela
function destravarAudio() {
    obterAudioContext();
    document.removeEventListener('click', destravarAudio);
    document.removeEventListener('touchstart', destravarAudio);
}
document.addEventListener('click', destravarAudio);
document.addEventListener('touchstart', destravarAudio);

// 1. ESTALO DE RÁDIO POLICIAL (Police Scanner Chirp do GTA)
function tocarBipRadioPolicia() {
    const ctx = obterAudioContext();
    if (!ctx) return;

    try {
        let bufferSize = ctx.sampleRate * 0.09; // 90ms
        let buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        let output = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            output[i] = Math.random() * 2 - 1;
        }

        let whiteNoise = ctx.createBufferSource();
        whiteNoise.buffer = buffer;

        let filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = 2400; // Frequência de rádio tático

        let noiseGain = ctx.createGain();
        noiseGain.gain.setValueAtTime(0.18, ctx.currentTime);
        noiseGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.09);

        whiteNoise.connect(filter);
        filter.connect(noiseGain);
        noiseGain.connect(ctx.destination);

        whiteNoise.start();
    } catch (e) {}
}

// 2. BUZINA HEAVY HORN (Buzina de Viatura do GTA)
function tocarBuzinaViatura() {
    const ctx = obterAudioContext();
    if (!ctx) return;

    try {
        let osc1 = ctx.createOscillator();
        let osc2 = ctx.createOscillator();
        let gain = ctx.createGain();
        let filter = ctx.createBiquadFilter();

        osc1.type = 'sawtooth';
        osc2.type = 'square';

        osc1.frequency.value = 145; // Tom grave da buzina americana
        osc2.frequency.value = 182; // Tom secundário (dupla buzina)

        filter.type = 'lowpass';
        filter.frequency.value = 900;

        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.4);

        osc1.connect(filter);
        osc2.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        osc1.start();
        osc2.start();
        osc1.stop(ctx.currentTime + 0.4);
        osc2.stop(ctx.currentTime + 0.4);
    } catch (e) {}
}

// 3. CONTROLADOR DA SIRENE (WAIL / YELP)
function alternarSomAmbiente() {
    const ctx = obterAudioContext();
    if (!ctx) return;

    if (!somAtivo) {
        try {
            tocarBipRadioPolicia();

            // Geradores de Som Duplo (Dual Horn LSPD)
            sirenOsc1 = ctx.createOscillator();
            sirenOsc2 = ctx.createOscillator();
            sirenOsc1.type = 'sawtooth';
            sirenOsc2.type = 'square';

            // Filtro de Megafone Metalizado
            sirenFilter = ctx.createBiquadFilter();
            sirenFilter.type = 'bandpass';
            sirenFilter.frequency.value = 1200;
            sirenFilter.Q.value = 2.5;

            sirenGain = ctx.createGain();
            sirenGain.gain.value = 0.20;

            sirenOsc1.connect(sirenFilter);
            sirenOsc2.connect(sirenFilter);
            sirenFilter.connect(sirenGain);
            sirenGain.connect(ctx.destination);

            const t = ctx.currentTime;
            sirenOsc1.start(t);
            sirenOsc2.start(t);

            // Frequências exatas do GTA V / Vice City
            const minFreq = 620;
            const maxFreq = 1450;
            
            // Alterna entre WAIL (lenta) e YELP (rápida)
            const riseTime = modoSirene === 'WAIL' ? 1.6 : 0.3;
            const fallTime = modoSirene === 'WAIL' ? 1.6 : 0.3;
            const cycleMs = (riseTime + fallTime) * 1000;

            function cicloSirene() {
                if (!somAtivo || !sirenOsc1) return;
                const now = ctx.currentTime;

                sirenOsc1.frequency.cancelScheduledValues(now);
                sirenOsc1.frequency.setValueAtTime(minFreq, now);
                sirenOsc1.frequency.linearRampToValueAtTime(maxFreq, now + riseTime);
                sirenOsc1.frequency.linearRampToValueAtTime(minFreq, now + riseTime + fallTime);

                sirenOsc2.frequency.cancelScheduledValues(now);
                sirenOsc2.frequency.setValueAtTime(minFreq + 20, now);
                sirenOsc2.frequency.linearRampToValueAtTime(maxFreq + 30, now + riseTime);
                sirenOsc2.frequency.linearRampToValueAtTime(minFreq + 20, now + riseTime + fallTime);
            }

            somAtivo = true;
            cicloSirene();
            sirenInterval = setInterval(cicloSirene, cycleMs);

            // Som Synthwave de Fundo
            oscAmbient = ctx.createOscillator();
            gainAmbient = ctx.createGain();
            oscAmbient.type = 'sawtooth';
            oscAmbient.frequency.value = 55;
            gainAmbient.gain.value = 0.08;

            let fGrave = ctx.createBiquadFilter();
            fGrave.type = 'lowpass';
            fGrave.frequency.value = 180;

            oscAmbient.connect(fGrave);
            fGrave.connect(gainAmbient);
            gainAmbient.connect(ctx.destination);
            oscAmbient.start(t);

            // Atualiza Interface
            atualizarBotaoSirene();
            console.log("🚨 Sirene GTA Ativada: " + modoSirene);

        } catch (erro) {
            console.error("Erro no som:", erro);
        }
    } else {
        desativarSomAmbiente();
    }
}

function desativarSomAmbiente() {
    tocarBipRadioPolicia();

    if (sirenInterval) clearInterval(sirenInterval);
    if (sirenOsc1) { try { sirenOsc1.stop(); sirenOsc1.disconnect(); } catch(e){} }
    if (sirenOsc2) { try { sirenOsc2.stop(); sirenOsc2.disconnect(); } catch(e){} }
    if (sirenFilter) { try { sirenFilter.disconnect(); } catch(e){} }
    if (oscAmbient) { try { oscAmbient.stop(); oscAmbient.disconnect(); } catch(e){} }

    somAtivo = false;
    atualizarBotaoSirene();
    console.log("🔇 Sirene Desligada.");
}

// Troca entre Sirene Lenta (WAIL) e Rápida (YELP)
function alternarModoSirene() {
    modoSirene = modoSirene === 'WAIL' ? 'YELP' : 'WAIL';
    if (somAtivo) {
        desativarSomAmbiente();
        alternarSomAmbiente();
    }
}

function atualizarBotaoSirene() {
    const btn = document.getElementById("btn-som-ambiente");
    const icone = document.getElementById("icone-som");
    if (btn) {
        btn.style.borderColor = somAtivo ? "var(--rosa-neon)" : "var(--azul-neon)";
    }
    if (icone) {
        icone.innerText = somAtivo ? (modoSirene === 'WAIL' ? '🚨 WAIL' : '⚡ YELP') : '🔊';
    }
}

// Vincula Evento ao Botão Principal
const btnSom = document.getElementById("btn-som-ambiente");
if (btnSom) {
    btnSom.addEventListener("click", alternarSomAmbiente);
}

// Efeito de Beep nos Botões
function tocarBeepHover() {
    const ctx = obterAudioContext();
    if (!ctx) return;
    try {
        let osc = ctx.createOscillator();
        let gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(850, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(350, ctx.currentTime + 0.06);

        gain.gain.setValueAtTime(0.05, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.06);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.06);
    } catch (e) {}
}

document.querySelectorAll('.btn-surreal, .menu-navegacao a, .botao-nav-glow').forEach(el => {
    el.addEventListener('mouseenter', tocarBeepHover);
});

