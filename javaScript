// =========================================================
// SIRENE POLICIAL DO GTA V / VICE CITY (SISTEMA DIRETO DE ÁUDIO)
// =========================================================

let audioCtx = null;
let sirenOsc1 = null;
let sirenOsc2 = null;
let sirenGain = null;
let sirenInterval = null;
let somAtivo = false;

// 1. Função que ativa e garante o áudio no navegador
function obterAudioContext() {
    if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioCtx.state === 'suspended') {
        audioCtx.resume();
    }
    return audioCtx;
}

// 2. Chiado de Rádio Policial (Police Scanner)
function tocarBipRadio() {
    const ctx = obterAudioContext();
    if (!ctx) return;
    try {
        let bufferSize = ctx.sampleRate * 0.08;
        let buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        let output = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) output[i] = Math.random() * 2 - 1;

        let noise = ctx.createBufferSource();
        noise.buffer = buffer;
        let gain = ctx.createGain();
        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);

        noise.connect(gain);
        gain.connect(ctx.destination);
        noise.start();
    } catch(e) {}
}

// 3. Função Principal da Sirene do GTA
function alternarSomAmbiente() {
    const ctx = obterAudioContext();

    if (!somAtivo) {
        try {
            tocarBipRadio();

            // Oscilador 1: Som metálico dente-de-serra
            sirenOsc1 = ctx.createOscillator();
            sirenOsc1.type = 'sawtooth';

            // Oscilador 2: Som encorpado de corneta LSPD (quadrada)
            sirenOsc2 = ctx.createOscillator();
            sirenOsc2.type = 'square';

            // Controle de Volume Alto (Sem filtros que abafam)
            sirenGain = ctx.createGain();
            sirenGain.gain.setValueAtTime(0.35, ctx.currentTime);

            sirenOsc1.connect(sirenGain);
            sirenOsc2.connect(sirenGain);
            sirenGain.connect(ctx.destination);

            const agora = ctx.currentTime;
            sirenOsc1.start(agora);
            sirenOsc2.start(agora);

            // Ritmo de Sirene de Perseguição do GTA (Yelp)
            const minFreq = 650;
            const maxFreq = 1450;
            const tempoSubida = 0.35; // segundos
            const tempoDescida = 0.35;
            const cicloMs = (tempoSubida + tempoDescida) * 1000;

            function cicloSirene() {
                if (!somAtivo || !sirenOsc1) return;
                const t = ctx.currentTime;

                // Frequência Oscilador 1
                sirenOsc1.frequency.cancelScheduledValues(t);
                sirenOsc1.frequency.setValueAtTime(minFreq, t);
                sirenOsc1.frequency.linearRampToValueAtTime(maxFreq, t + tempoSubida);
                sirenOsc1.frequency.linearRampToValueAtTime(minFreq, t + tempoSubida + tempoDescida);

                // Frequência Oscilador 2 (+20Hz para criar batimento de viatura americana)
                sirenOsc2.frequency.cancelScheduledValues(t);
                sirenOsc2.frequency.setValueAtTime(minFreq + 20, t);
                sirenOsc2.frequency.linearRampToValueAtTime(maxFreq + 30, t + tempoSubida);
                sirenOsc2.frequency.linearRampToValueAtTime(minFreq + 20, t + tempoSubida + tempoDescida);
            }

            somAtivo = true;
            cicloSirene();
            sirenInterval = setInterval(cicloSirene, cicloMs);

            // Atualiza texto do botão se existir
            const btn = document.getElementById("btn-som-ambiente");
            if (btn) btn.innerHTML = "🚨 DESLIGAR SIRENE GTA";

            console.log("🚨 Sirene GTA Ligada!");
        } catch (err) {
            alert("Erro ao tocar áudio: " + err);
        }
    } else {
        desativarSirene();
    }
}

function desativarSirene() {
    tocarBipRadio();
    if (sirenInterval) clearInterval(sirenInterval);
    if (sirenOsc1) { try { sirenOsc1.stop(); sirenOsc1.disconnect(); } catch(e){} }
    if (sirenOsc2) { try { sirenOsc2.stop(); sirenOsc2.disconnect(); } catch(e){} }
    somAtivo = false;

    const btn = document.getElementById("btn-som-ambiente");
    if (btn) btn.innerHTML = "🔊 LIGAR SIRENE GTA";
}

// Vincula o evento ao carregar a página
document.addEventListener("DOMContentLoaded", function() {
    const btn = document.getElementById("btn-som-ambiente");
    if (btn) {
        btn.onclick = alternarSomAmbiente;
    }
});
