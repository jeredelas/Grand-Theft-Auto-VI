// Contagem Regressiva GTA VI
const dataLancamento = new Date("December 31, 2026 00:00:00").getTime();
setInterval(function() {
    const elDias = document.getElementById("dias");
    if (!elDias) return;

    const agora = new Date().getTime();
    const distancia = dataLancamento - agora;
    const dias = Math.floor(distancia / (1000 * 60 * 60 * 24));
    const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
    const segundos = Math.floor((distancia % (1000 * 60)) / 1000);

    document.getElementById("dias").innerText = dias < 10 ? "0" + dias : dias;
    document.getElementById("horas").innerText = horas < 10 ? "0" + horas : horas;
    document.getElementById("minutos").innerText = minutos < 10 ? "0" + minutos : minutos;
    document.getElementById("segundos").innerText = segundos < 10 ? "0" + segundos : segundos;
}, 1000);

// Barra de Progresso de Rolagem
window.onscroll = function() {
    const barra = document.getElementById("barra-progresso");
    if (!barra) return;
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    barra.style.width = scrolled + "%";
};

// Lightbox Modal
const modal = document.getElementById("modal-lightbox");
const imgModal = document.getElementById("img-modal-zoom");
const btnFechar = document.getElementsByClassName("fechar-modal")[0];

if (modal && imgModal) {
    document.querySelectorAll('.img-ampliavel').forEach(img => {
        img.onclick = function() {
            modal.style.display = "flex";
            imgModal.src = this.src;
        }
    });

    if (btnFechar) btnFechar.onclick = function() { modal.style.display = "none"; }
    modal.onclick = function(e) { if(e.target === modal) modal.style.display = "none"; }
}

// Widget de Rádio Vice City
const estacoes = [
    "Estação: Wave 103 (Synthwave)",
    "Estação: Flash FM (Hits Pop 80s)",
    "Estação: V-Rock (Hard Rock)",
    "Estação: Fever 105 (Funk & Soul)"
];
let estacaoAtual = 0;
let tocando = false;

const elEstacao = document.getElementById("radio-musica");
const btnPlay = document.getElementById("btn-radio-play");
const btnNext = document.getElementById("btn-radio-next");
const btnPrev = document.getElementById("btn-radio-prev");

if (btnNext) {
    btnNext.onclick = () => {
        estacaoAtual = (estacaoAtual + 1) % estacoes.length;
        if (elEstacao) elEstacao.innerText = estacoes[estacaoAtual];
    };
}

if (btnPrev) {
    btnPrev.onclick = () => {
        estacaoAtual = (estacaoAtual - 1 + estacoes.length) % estacoes.length;
        if (elEstacao) elEstacao.innerText = estacoes[estacaoAtual];
    };
}

if (btnPlay) {
    btnPlay.onclick = () => {
        tocando = !tocando;
        btnPlay.innerText = tocando ? "⏸" : "▶";
        btnPlay.classList.toggle("ativo", tocando);
    };
}

// Formulário VIP
const formVip = document.getElementById("form-vip");
if (formVip) {
    formVip.onsubmit = function(e) {
        e.preventDefault();
        const email = document.getElementById("email-vip").value;
        const msg = document.getElementById("mensagem-vip");
        if (msg) msg.innerText = "✔ Sucesso! O e-mail " + email + " foi registrado na lista VIP.";
        document.getElementById("email-vip").value = "";
    };
}
window.addEventListener('keydown', (e) => {
    if (e.key === '1') alternarSomAmbiente();
    if (e.key === '2') alternarModoSirene();
    if (e.key === '3') tocarBuzinaViatura();
});
